# Шаблон без секретов. Не копировать DEV-настройки в production.
# DEV: ops/.secrets/dev/app.env; production: ops/.secrets/shop.env (600).
APP_ENV=dev
PUBLIC_ORIGIN=
MW_INSTANCE_ID=
# Публичные параметры: должны совпадать при сборке и запуске.
VITE_APP_ENV=dev
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Только сервер; в браузер и build args не передавать.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_TRANSPORT=direct
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Старый Lovable transport поддержан только вне явных APP_ENV.
# В DEV/production использовать direct и отдельного бота каждой среды.
