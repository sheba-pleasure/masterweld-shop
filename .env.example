# Пример без значений. Реальные значения — только на сервере в ops/.secrets/shop.env (chmod 600).
# Публичные (нужны при сборке образа, --build-arg):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Серверные (только при запуске контейнера, --env-file):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
TELEGRAM_API_KEY=
