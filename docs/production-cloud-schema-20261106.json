  "policies": [
    {
      "cmd": "SELECT",
      "policyname": "Public can read categories",
      "qual": "true",
      "roles": [
        "anon",
        "authenticated"
      ],
      "tablename": "categories",
      "with_check": null
    },
    {
      "cmd": "SELECT",
      "policyname": "Public can read photos of published products",
      "qual": "(EXISTS ( SELECT 1\n   FROM products p\n  WHERE ((p.id = product_photos.product_id) AND (p.status = 'published'::product_status))))",
      "roles": [
        "anon",
        "authenticated"
      ],
      "tablename": "product_photos",
      "with_check": null
    },
    {
      "cmd": "SELECT",
      "policyname": "Public can read published products",
      "qual": "(status = 'published'::product_status)",
      "roles": [
        "anon",
        "authenticated"
      ],
      "tablename": "products",
      "with_check": null
    },
    {
      "cmd": "INSERT",
      "policyname": "Shoppers can place an order",
      "qual": null,
      "roles": [
        "anon",
        "authenticated"
      ],
      "tablename": "shop_orders",
      "with_check": "(((char_length(btrim(name)) >= 2) AND (char_length(btrim(name)) <= 200)) AND ((char_length(btrim(phone)) >= 5) AND (char_length(btrim(phone)) <= 40)) AND ((comment IS NULL) OR (char_length(comment) <= 1000)) AND (total >= (0)::numeric) AND (total < (100000000)::numeric) AND (jsonb_typeof(items) = 'array'::text) AND ((jsonb_array_length(items) >= 1) AND (jsonb_array_length(items) <= 200)))"
    }
  ],
